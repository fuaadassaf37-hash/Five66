# منفذ السيرفر
PORT=3000

# حساب المشرف (إلزامي) — صلاحية كاملة: قراءة + تعديل + تنزيل نسخة احتياطية
ADMIN_USER=five66
ADMIN_PASS=غيّر_هذه_القيمة_قبل_النشر

# حساب المشاهدة (اختياري) — قراءة فقط، لا يستطيع حفظ أي تعديل على السيرفر
# اتركه فارغاً إن كنت تريد حساب المشرف فقط
VIEWER_USER=five1
VIEWER_PASS=غيّر_هذه_القيمة_قبل_النشر

# بيانات Supabase (اختياري — إن لم تُضبط سيُستخدم ملف محلي data/state.json)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-service-role-key

# تنبيهات تيليجرام فورية عند فشل/عودة الاتصال بـ Supabase (اختياري لكن مهم جداً).
# بدون ضبط هذين المتغيّرين، أي انقطاع في Supabase سيُسجَّل في الـ logs فقط
# ولن يصلك أي تنبيه — وقد تفقد بيانات محفوظة محلياً فقط عند إعادة نشر السيرفر.
# طريقة الإعداد:
# 1) افتح تيليجرام وتحدّث مع @BotFather ثم أرسل /newbot واتبع التعليمات
#    للحصول على TELEGRAM_BOT_TOKEN
# 2) ابدأ محادثة مع البوت الجديد (اضغط Start)
# 3) تحدّث مع @myidbot أو @userinfobot لمعرفة TELEGRAM_CHAT_ID الخاص بحسابك
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ترحيل بيانات لمرة واحدة (اختياري): يطبّق تعديل الحالة الاجتماعية وأرقام
# التواصل تلقائياً عند بدء تشغيل السيرفر — راجع migrate-persons-fix.js
# اضبطه إلى true في متغيرات Railway، أعد النشر، ثم راقب الـ logs للتأكد
# من نجاح الترحيل. آمن للتكرار — يمكن تركه أو حذفه بعد التأكد.
RUN_PERSON_FIX_2026_08=false
